rules_version = '2';

// Reglas de seguridad de Firestore para FULBITO.
// Cada usuario solo puede ESCRIBIR sus propios datos. La LECTURA es publica entre
// cuentas con sesion (ninguno de estos datos es sensible: nombre, monedas, jugadores
// y equipo) para que en el modo de 2 jugadores el Equipo B pueda usar su propia
// cuenta (buscada por nombre) sin necesitar iniciar sesion como el.
// Pegar este archivo completo en: Firebase Console -> Firestore Database -> Reglas -> Publicar.

service cloud.firestore {
  match /databases/{database}/documents {

    // profiles/{uid}: nombre de jugador, color y monedas ganadas jugando.
    // Las monedas y el record (wins/losses/draws) se escriben siempre con increment()
    // desde el cliente (ver js/auth.js): eso deja comparar el valor viejo contra el
    // nuevo aca y limitar cuanto puede subir de una sola vez, para que nadie se de
    // monedas o victorias de mas escribiendo directo con la consola del navegador.
    // Gastar monedas en la tienda (numeros negativos) sigue libre.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.coins == 50
                    && request.resource.data.wins == 0
                    && request.resource.data.losses == 0
                    && request.resource.data.draws == 0;
      allow update: if request.auth != null && request.auth.uid == uid
                    && (request.resource.data.coins - resource.data.coins) <= 50
                    && (request.resource.data.wins - resource.data.wins) <= 1
                    && (request.resource.data.losses - resource.data.losses) <= 1
                    && (request.resource.data.draws - resource.data.draws) <= 1;
      allow delete: if false;
    }

    // players/{playerId}: jugadores que el usuario compro en la tienda o creo el mismo.
    // La regla central del juego es "sin pay to win": todo jugador de campo reparte 11
    // puntos y todo arquero reparte 7, nunca mas. El creador de jugador y la tienda ya lo
    // respetan del lado del cliente, pero eso solo no alcanza (cualquiera con la consola
    // del navegador podria escribir un documento distinto); se valida de nuevo aca, que es
    // lo unico que Firestore realmente hace cumplir.
    function sumFieldSkills(s) {
      return s.fuerza + s.pase + s.precision + s.tiro + s.defensa;
    }
    function sumKeeperSkills(s) {
      return s.altura + s.velocidad + s.volada + s.salto;
    }
    function isValidPlayerSkills(data) {
      return (data.type == 'field'
                && data.skills.fuerza is number && data.skills.pase is number
                && data.skills.precision is number && data.skills.tiro is number
                && data.skills.defensa is number && sumFieldSkills(data.skills) == 11)
          || (data.type == 'keeper'
                && data.skills.altura is number && data.skills.velocidad is number
                && data.skills.volada is number && data.skills.salto is number
                && sumKeeperSkills(data.skills) == 7);
    }
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid
                    && isValidPlayerSkills(request.resource.data);
      // Update solo se usa para sumar estadisticas de carrera (goles/tiros/atajadas) despues
      // de un partido: las habilidades, el tipo y el dueño no pueden cambiar despues de creado.
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
                    && request.resource.data.skills == resource.data.skills
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // teams/{uid}: el equipo activo del usuario (un solo documento, id = su uid).
    match /teams/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // onlineRooms/{code}: una sala de partido online, id = codigo corto que el anfitrion
    // comparte con su rival (ver js/online-repo.js). El anfitrion nunca puede cambiar
    // despues de creada la sala; el lugar de invitado solo se puede reclamar una vez
    // (mientras este vacio) y despues solo el anfitrion o el invitado ya conectado
    // pueden seguir escribiendo (ahi va el estado del partido, turno a turno).
    match /onlineRooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.guestUid == null
                    && request.resource.data.status == 'waiting';
      allow update: if request.auth != null
                    && request.resource.data.hostUid == resource.data.hostUid
                    && (
                         (resource.data.guestUid == null && request.resource.data.guestUid == request.auth.uid)
                         || resource.data.hostUid == request.auth.uid
                         || resource.data.guestUid == request.auth.uid
                       );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
  }
}
