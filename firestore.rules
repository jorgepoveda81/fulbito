rules_version = '2';

// Reglas de seguridad de Firestore para FULBITO.
// Cada usuario solo puede ESCRIBIR sus propios datos. La LECTURA es publica entre
// cuentas con sesion (ninguno de estos datos es sensible: nombre, monedas, jugadores
// y equipo) para que en el modo de 2 jugadores el Equipo B pueda usar su propia
// cuenta (buscada por nombre) sin necesitar iniciar sesion como el.
// Pegar este archivo completo en: Firebase Console -> Firestore Database -> Reglas -> Publicar.

service cloud.firestore {
  match /databases/{database}/documents {

    // profiles/{uid}: nombre de jugador, edad, color y monedas ganadas jugando.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // players/{playerId}: jugadores que el usuario compro en la tienda o creo el mismo.
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // teams/{uid}: el equipo activo del usuario (un solo documento, id = su uid).
    match /teams/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
